<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BagVati - Welcome</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Roboto', sans-serif;
      background-color: #f3f4f6;
    }
    .header-title {
      font-family: 'Playfair Display', serif;
    }
  </style>
</head>
<body class="bg-gray-100">
  <!-- Header Section -->
  <header class="text-center py-10 bg-white shadow-md">
    <h1 class="header-title text-4xl md:text-5xl font-bold">
      <span class="text-orange-500 italic">Bag</span>Vati
    </h1>
    <p class="text-gray-600 tracking-wide uppercase text-sm mt-2">Your Gateway to Style</p>
  </header>
  <div>
    <button class="bg-blue-500 p-2 border rounded hover:bg-orange-500"><a href="/owners/login"> Admin login </a></button>
  </div>
  <!-- Main Section -->
  <div class="min-h-screen flex flex-col justify-center items-center py-10">
    <!-- Welcome Heading -->
    <h3 class="text-4xl text-center mb-10 mt-10 lg:mt-20 font-semibold header-title"> 
      Welcome to <span class="text-orange-500 italic">BagVati</span>
    </h3>
    <!-- Main Section: Sign up and Log in -->
    <div class="w-full max-w-6xl flex flex-col lg:flex-row justify-center items-center gap-10 lg:gap-16">
      <!-- Left side: Sign Up Form -->
      <div class="w-full lg:w-1/3 bg-white rounded-lg shadow-lg p-8">
        <h2 class="text-3xl font-semibold text-center mb-6 header-title">Sign up</h2>
        <form action="/users/register" method="POST" class="space-y-4">
          <!-- Name Field -->
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
            <input type="text" id="name" name="name" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <!-- Email Field -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
            <input type="email" id="email" name="email" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <!-- Password Field -->
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
            <input type="password" id="password" name="password" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <!-- Submit Button -->
          <div>
            <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-md font-semibold hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">Sign Up</button>
          </div>
        </form>

        <p class="text-center text-sm text-gray-500 mt-4">
          Already have an account? <a href="#" class="text-blue-600 hover:underline">Log In</a>
        </p>

        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-300"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-2 bg-white text-gray-500">or</span>
          </div>
        </div>

        <div>
          <button class="w-full flex items-center justify-center py-2 border border-gray-300 rounded-md shadow-sm bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
            <img src="https://www.google.com/favicon.ico" alt="Google" class="w-5 h-5 mr-2">
            Sign up with Google
          </button>
        </div>
      </div>

      <!-- Right side: Log In Form -->
      <div class="w-full lg:w-1/3 bg-white rounded-lg shadow-lg p-8">
        <h2 class="text-3xl font-semibold text-center mb-6 header-title">Log In</h2>
        <form action="/users/login" method="POST" class="space-y-4">
          <!-- Email Field -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
            <input type="email" id="email" name="email" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <!-- Password Field -->
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
            <input type="password" id="password" name="password" required class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
          </div>
          <!-- Submit Button -->
          <div>
            <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-md font-semibold hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">Log In</button>
          </div>
        </form>

        <p class="text-center text-sm text-gray-500 mt-4">
          Don't have an account? <a href="#" class="text-blue-600 hover:underline">Sign Up</a>
        </p>

        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-300"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-2 bg-white text-gray-500">or</span>
          </div>
        </div>

        <div>
          <button class="w-full flex items-center justify-center py-2 border border-gray-300 rounded-md shadow-sm bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
            <img src="https://www.google.com/favicon.ico" alt="Google" class="w-5 h-5 mr-2">
            Log in with Google
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Section -->
  <footer class="py-6 bg-white shadow-md text-center">
    <p class="text-gray-500 text-sm">&copy; 2025 BagVati. All rights reserved.</p>
  </footer>
</body>
</html>
