<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BagVati</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
        }

        .header-title {
            font-family: 'Playfair Display', serif;
        }

        nav ul li a:hover {
            color: #fb923c; /* Orange hover effect */
        }
    </style>
</head>

<body x-data="{ navOpen: false, scrolledFromTop: false }"
    x-init="window.pageYOffset >= 50 ? scrolledFromTop = true : scrolledFromTop = false"
    @scroll.window="window.pageYOffset >= 50 ? scrolledFromTop = true : scrolledFromTop = false"
    :class="{ 'overflow-hidden': navOpen, 'overflow-scroll': !navOpen }">

    <!-- Navbar Section -->
    <header class="fixed w-full bg-white shadow-lg flex justify-between items-center px-6 md:px-12 transition-all duration-200 h-20 z-50"
        :class="{ 'h-24': !scrolledFromTop, 'h-16': scrolledFromTop }">

        <!-- Logo Section -->
        <a href="/" class="flex items-center">
            <h1 class="header-title text-4xl text-orange-500 font-bold transform origin-left transition duration-200"
                :class="{ 'scale-100': !scrolledFromTop, 'scale-90': scrolledFromTop }">
                Bag<span class="text-black">Vati</span>
            </h1>
        </a>

        <!-- Right Section: Navigation -->
        <nav>
            <ul class="fixed left-0 right-0 min-h-screen px-6 pt-16 space-y-6 bg-white text-gray-700 transform transition duration-300 translate-x-full md:relative md:flex md:space-x-8 md:min-h-0 md:py-0 md:space-y-0 md:translate-x-0"
                :class="{ 'translate-x-full': !navOpen, 'translate-x-0': navOpen }">
                <li class="text-lg md:text-base">
                    <a href="/" @click="navOpen = false" class="hover:text-orange-500">Home</a>
                </li>
                <li class="text-lg md:text-base">
                    <a href="/shop" @click="navOpen = false" class="hover:text-orange-500">Products</a>
                </li>
                <li class="text-lg md:text-base">
                    <a href="/about" @click="navOpen = false" class="hover:text-orange-500">About</a>
                </li>
                <li class="text-lg md:text-base">
                    <a href="/contact" @click="navOpen = false" class="hover:text-orange-500">Contact</a>
                </li>
                <% if (user) { %>
                <li class="text-lg md:text-base md:hidden">
                    <a href="/profile" @click="navOpen = false" class="hover:text-orange-500 flex items-center gap-2">
                        <i class="ri-user-line text-xl"></i>
                        Profile
                    </a>
                </li>
                <% } %>
            </ul>
        </nav>

        <!-- Right-side controls: show profile (with dropdown) if logged in, otherwise Sign Up / Login -->
        <div class="ml-4">
            <% if (user || owner) { %>
            <div class="hidden md:block relative group">
                <div class="w-10 h-10 rounded-full overflow-hidden border-2 border-orange-500 bg-gray-100 flex items-center justify-center">
                    <i class="ri-user-line text-xl text-gray-700"></i>
                </div>

                <!-- Dropdown (shows on hover) -->
                <div class="absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transform translate-y-2 group-hover:translate-y-0 transition-all duration-200 z-50">
                    <ul class="py-2">
                        <li><a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50">Account Details</a></li>
                        <% if(user) { %>
                        <li><a href="/cart" class="block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50">Cart</a></li>
                        <li><a href="/users/orders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50">Orders</a></li>
                        <li><a href="/wishlist" class="block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50">Wishlist</a></li>
                        <li><a href="/coupons" class="block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50">Coupons</a></li>
                        <li><a href="/whats-new" class="block px-4 py-2 text-sm text-gray-700 hover:bg-orange-50">What's New</a></li>
                        <% } %>
                        <li><hr class="my-1"></li>
                        <li><a href="/users/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50">Logout</a></li>
                    </ul>
                </div>
            </div>
            <% } else { %>
            <div class="hidden md:flex items-center gap-3">
                <a href="/register" class="text-sm px-3 py-1 rounded-full border border-orange-500 text-orange-500 bg-white hover:bg-orange-50">Sign Up</a>
                <a href="/main" class="text-sm px-3 py-1 rounded-full bg-orange-500 text-white hover:opacity-90">Login</a>
            </div>
            <% } %>
        </div>

        <!-- Mobile Menu Button -->
        <button @click="navOpen = !navOpen" class="text-gray-700 md:hidden focus:outline-none">
            <i :class="navOpen ? 'ri-close-line' : 'ri-menu-line'" class="text-2xl"></i>
        </button>
    </header>

</body>

</html>
