
<%- include('partials/header') %>
<% const amountText = amount.toLocaleString('en-IN'); %>

<div class="max-w-5xl mx-auto pt-32 pb-20 px-4 md:px-6">
  <!-- Progress Steps -->
  <div class="flex items-center justify-center mb-8">
    <div class="flex items-center gap-2 text-sm font-medium">
      <div class="flex items-center gap-1 text-orange-500">
        <span class="w-6 h-6 flex items-center justify-center rounded-full bg-orange-500 text-white">1</span>
        <span>Cart</span>
      </div>
      <span class="text-gray-400">→</span>
      <div class="flex items-center gap-1 text-orange-500">
        <span class="w-6 h-6 flex items-center justify-center rounded-full bg-orange-500 text-white">2</span>
        <span>Address</span>
      </div>
      <span class="text-gray-400">→</span>
      <div class="flex items-center gap-1 text-orange-500">
        <span class="w-6 h-6 flex items-center justify-center rounded-full bg-orange-500 text-white">3</span>
        <span>Payment</span>
      </div>
    </div>
  </div>

  <div class="flex flex-col md:flex-row gap-8">
    <!-- Main Payment Section -->
    <div class="flex-1 bg-white rounded-xl shadow-lg p-8 flex flex-col gap-8">
      <h1 class="header-title text-2xl md:text-3xl text-gray-800 mb-2">Payment</h1>
      <!-- Address Section (placeholder) -->
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-2">
          <span class="font-semibold text-gray-700">Deliver to:</span>
          <span class="text-gray-600">(Default Address)</span>
          <button class="ml-2 text-orange-500 text-xs underline hover:text-orange-600">Change</button>
        </div>
        <div class="text-gray-500 text-sm">123, Your Street, City, State, 123456</div>
      </div>
      <form action="/payment/process" method="POST" class="space-y-6" id="payment-form" data-amount="<%= amountText %>">
        <!-- masked summary only (•••• 4242 / UPI id / bank); raw card fields below have no name and never leave the browser -->
        <input type="hidden" name="detail" id="pay-detail">
        <div>
          <h2 class="text-lg font-semibold mb-4">Select Payment Method</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="flex items-center gap-3 p-4 border rounded-lg cursor-pointer hover:shadow transition">
              <input type="radio" name="paymentMethod" value="upi" required class="accent-orange-500">
              <!-- Banknotes SVG -->
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-orange-500"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6.75A2.25 2.25 0 015.25 4.5h13.5A2.25 2.25 0 0121 6.75v10.5A2.25 2.25 0 0118.75 19.5H5.25A2.25 2.25 0 013 17.25V6.75z" /><path stroke-linecap="round" stroke-linejoin="round" d="M3 6.75V8.25a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 8.25V6.75" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 15.75a3 3 0 100-6 3 3 0 000 6z" /></svg>
              <span>UPI</span>
            </label>
            <label class="flex items-center gap-3 p-4 border rounded-lg cursor-pointer hover:shadow transition">
              <input type="radio" name="paymentMethod" value="credit" required class="accent-orange-500">
              <!-- Credit Card SVG -->
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-orange-500"><rect x="3" y="6" width="18" height="12" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18" /><path stroke-linecap="round" stroke-linejoin="round" d="M7 16h2" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 16h2" /></svg>
              <span>Credit Card</span>
            </label>
            <label class="flex items-center gap-3 p-4 border rounded-lg cursor-pointer hover:shadow transition">
              <input type="radio" name="paymentMethod" value="debit" required class="accent-orange-500">
              <!-- Credit Card SVG (same as above) -->
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-orange-500"><rect x="3" y="6" width="18" height="12" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18" /><path stroke-linecap="round" stroke-linejoin="round" d="M7 16h2" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 16h2" /></svg>
              <span>Debit Card</span>
            </label>
            <label class="flex items-center gap-3 p-4 border rounded-lg cursor-pointer hover:shadow transition">
              <input type="radio" name="paymentMethod" value="netbanking" required class="accent-orange-500">
              <!-- Building Bank SVG -->
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-orange-500"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10v10h18V10" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 4l9 6H3l9-6z" /><path stroke-linecap="round" stroke-linejoin="round" d="M7 14v2" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 14v2" /><path stroke-linecap="round" stroke-linejoin="round" d="M17 14v2" /></svg>
              <span>Net Banking</span>
            </label>
            <label class="flex items-center gap-3 p-4 border rounded-lg cursor-pointer hover:shadow transition col-span-1 sm:col-span-2">
              <input type="radio" name="paymentMethod" value="cod" required class="accent-orange-500">
              <!-- Cash SVG -->
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-orange-500"><rect x="3" y="7" width="18" height="10" rx="2"/><circle cx="12" cy="12" r="2.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 12h.01M17 12h.01" /></svg>
              <span>Cash on Delivery (COD)</span>
            </label>
          </div>
        </div>
        <div class="sticky bottom-0 bg-white pt-4 pb-2 z-10">
          <button type="submit" id="pay-btn" class="w-full bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition text-lg shadow">Pay ₹ <%= amountText %></button>
        </div>

        <!-- Demo payment gateway (test mode, nothing is charged) -->
        <div id="gateway" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4" role="dialog" aria-modal="true" aria-labelledby="gw-title">
          <div class="w-full max-w-md bg-white rounded-xl shadow-2xl overflow-hidden">
            <div class="bg-gray-900 text-white px-6 py-4 flex items-center justify-between gap-4">
              <div>
                <div id="gw-title" class="font-semibold">BagVati Pay <span class="ml-1 text-xs bg-yellow-400 text-gray-900 px-2 py-0.5 rounded align-middle">TEST MODE</span></div>
                <div id="gw-method" class="text-xs text-gray-300 mt-1"></div>
              </div>
              <div class="text-right">
                <div class="text-xs text-gray-300">Amount</div>
                <div class="text-lg font-bold">₹ <%= amountText %></div>
              </div>
            </div>
            <div class="bg-yellow-50 text-yellow-800 text-xs px-6 py-2">Demo payment: no money is charged. Please don't enter real card details.</div>

            <div id="gw-form" class="p-6 space-y-4">
              <fieldset data-method="upi" disabled class="hidden space-y-2">
                <label for="gw-upi" class="block text-sm font-medium text-gray-700">UPI ID</label>
                <input id="gw-upi" type="text" required autocomplete="off" pattern="[A-Za-z0-9._\-]{2,}@[A-Za-z]{2,}" title="e.g. yourname@okaxis" placeholder="yourname@okaxis" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-orange-300">
              </fieldset>

              <fieldset data-method="card" disabled class="hidden space-y-3">
                <div>
                  <label for="gw-card" class="block text-sm font-medium text-gray-700">Card number</label>
                  <input id="gw-card" type="text" inputmode="numeric" required autocomplete="off" maxlength="19" pattern="[0-9]{4} ?[0-9]{4} ?[0-9]{4} ?[0-9]{4}" title="16-digit card number" placeholder="4242 4242 4242 4242" class="w-full border rounded px-3 py-2 tracking-widest focus:outline-none focus:ring-2 focus:ring-orange-300">
                </div>
                <div>
                  <label for="gw-card-name" class="block text-sm font-medium text-gray-700">Name on card</label>
                  <input id="gw-card-name" type="text" required autocomplete="off" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-orange-300">
                </div>
                <div class="flex gap-3">
                  <div class="flex-1">
                    <label for="gw-expiry" class="block text-sm font-medium text-gray-700">Expiry</label>
                    <input id="gw-expiry" type="text" inputmode="numeric" required autocomplete="off" maxlength="5" pattern="(0[1-9]|1[0-2])/[0-9]{2}" title="MM/YY" placeholder="MM/YY" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-orange-300">
                  </div>
                  <div class="flex-1">
                    <label for="gw-cvv" class="block text-sm font-medium text-gray-700">CVV</label>
                    <input id="gw-cvv" type="password" inputmode="numeric" required autocomplete="off" maxlength="4" pattern="[0-9]{3,4}" title="3 or 4 digits" placeholder="•••" class="w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-orange-300">
                  </div>
                </div>
              </fieldset>

              <fieldset data-method="netbanking" disabled class="hidden space-y-2">
                <label for="gw-bank" class="block text-sm font-medium text-gray-700">Choose your bank</label>
                <select id="gw-bank" required class="w-full border rounded px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-orange-300">
                  <option value="">Select a bank</option>
                  <option>State Bank of India</option>
                  <option>HDFC Bank</option>
                  <option>ICICI Bank</option>
                  <option>Axis Bank</option>
                  <option>Kotak Mahindra Bank</option>
                </select>
              </fieldset>

              <fieldset data-method="cod" disabled class="hidden">
                <p class="text-gray-700">Pay <strong>₹ <%= amountText %></strong> in cash when your order arrives.</p>
              </fieldset>

              <div class="flex gap-3 pt-2">
                <button type="button" id="gw-cancel" class="flex-1 border border-gray-300 rounded-lg py-2 font-medium hover:bg-gray-50">Cancel</button>
                <button type="submit" id="gw-pay" class="flex-1 bg-orange-500 text-white rounded-lg py-2 font-semibold hover:bg-orange-600">Pay ₹ <%= amountText %></button>
              </div>
            </div>

            <div id="gw-processing" class="hidden p-10 text-center" aria-live="polite">
              <div class="mx-auto mb-4 h-12 w-12 rounded-full border-4 border-orange-200 border-t-orange-500 animate-spin"></div>
              <p class="font-semibold text-gray-800">Processing payment…</p>
              <p class="text-sm text-gray-500 mt-1">Please don't close or refresh this window.</p>
            </div>
          </div>
        </div>
      </form>
    </div>
    <!-- Order Summary Sidebar -->
    <div class="w-full md:w-80 bg-gray-50 rounded-xl shadow-md p-6 h-fit">
      <h2 class="text-lg font-semibold mb-4 text-gray-700">Order Summary</h2>
      <div class="flex justify-between items-center mb-2">
        <span class="text-gray-600">Total Amount</span>
        <span class="text-xl font-bold text-green-600">₹ <%= amount %></span>
      </div>
      <div class="border-t border-gray-200 my-4"></div>
      <div class="text-sm text-gray-500 mb-2">Payments run through BagVati Pay in test mode. No money is charged.</div>
      <div class="text-xs text-gray-400">By placing your order, you agree to our <a href="/terms" class="text-orange-500 underline">Terms & Conditions</a>.</div>
    </div>
  </div>
</div>

<script>
(function () {
  const form = document.getElementById('payment-form');
  const gateway = document.getElementById('gateway');
  const fieldsets = gateway.querySelectorAll('fieldset[data-method]');
  const amount = form.dataset.amount;
  const labels = { upi: 'UPI', credit: 'Credit Card', debit: 'Debit Card', netbanking: 'Net Banking', cod: 'Cash on Delivery' };
  const group = (m) => (m === 'credit' || m === 'debit') ? 'card' : m;
  const payText = (m) => m === 'cod' ? 'Place Order' : 'Pay ₹ ' + amount;
  let method = null;
  let processing = false;

  // Only the visible fieldset is enabled, so native validation checks just that method's fields.
  function show(m) {
    method = m;
    gateway.classList.toggle('hidden', !m);
    gateway.classList.toggle('flex', !!m);
    fieldsets.forEach(function (fs) {
      const on = !!m && fs.dataset.method === group(m);
      fs.disabled = !on;
      fs.classList.toggle('hidden', !on);
    });
    if (!m) return;
    document.getElementById('gw-method').textContent = labels[m];
    document.getElementById('gw-pay').textContent = payText(m);
    const first = gateway.querySelector('fieldset:not([disabled]) input, fieldset:not([disabled]) select');
    if (first) first.focus();
  }

  form.querySelectorAll('input[name="paymentMethod"]').forEach(function (radio) {
    radio.addEventListener('change', function () { document.getElementById('pay-btn').textContent = payText(radio.value); });
  });

  document.getElementById('gw-card').addEventListener('input', function (e) {
    e.target.value = e.target.value.replace(/\D/g, '').slice(0, 16).replace(/(\d{4})(?=\d)/g, '$1 ');
  });
  document.getElementById('gw-expiry').addEventListener('input', function (e) {
    const d = e.target.value.replace(/\D/g, '').slice(0, 4);
    e.target.value = d.length > 2 ? d.slice(0, 2) + '/' + d.slice(2) : d;
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (processing) return;
    if (!method) return show(form.paymentMethod.value);

    const g = group(method);
    document.getElementById('pay-detail').value =
      g === 'card' ? '•••• ' + document.getElementById('gw-card').value.replace(/\D/g, '').slice(-4)
      : g === 'upi' ? document.getElementById('gw-upi').value.trim()
      : g === 'netbanking' ? document.getElementById('gw-bank').value
      : '';

    processing = true;
    document.getElementById('gw-form').classList.add('hidden');
    document.getElementById('gw-processing').classList.remove('hidden');
    setTimeout(function () { form.submit(); }, 2000);
  });

  document.getElementById('gw-cancel').addEventListener('click', function () { show(null); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && method && !processing) show(null); });
})();
</script>

<%- include('partials/footer') %>
