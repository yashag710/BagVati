<%- include('./partials/header') %>
<div class="w-full min-h-screen flex px-16 py-20 bg-gray-100">
    <!-- Sidebar -->
    <div class="w-1/4 h-full bg-white shadow-md rounded-lg p-6 flex flex-col mt-16">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Dashboard</h2>
        <nav class="flex flex-col gap-3">
            <a class="text-gray-700 hover:text-blue-500 transition" href="/owners/admin">All Products</a>
            <a class="text-gray-700 hover:text-blue-500 transition" href="/products/create">Create New Product</a>
        </nav>
    </div>
    
    <!-- Main Content -->
    <div class="w-3/4 flex flex-col gap-6 ml-10">
        <div class="flex justify-between items-center">
            <h2 class="text-2xl font-semibold text-gray-800">All Products</h2>
            <form action="/products/delete" method="post">
                <button type="submit" class="bg-red-500 text-white rounded-lg px-4 py-2 hover:bg-red-600 transition duration-300 flex items-center gap-2">
                    <i class="ri-delete-bin-line"></i>
                    Delete All Products
                </button>
            </form>
        </div>
        
        <!-- Products Section -->
        <div class="w-full">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                <% products.forEach(function (product) { %>
                    <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 overflow-hidden">
                        <!-- Product Image -->
                        <div class="w-full h-64 flex items-center justify-center bg-[<%= product.bgcolor %>] relative group">
                            <img 
                                class="h-60 w-full object-contain transition-transform duration-300 transform group-hover:scale-105" 
                                src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" 
                                alt="<%= product.name || 'Product Image' %>"
                            />
                        </div>
                
                        <!-- Product Details -->
                        <div class="p-6 bg-[<%= product.panelcolor %>] text-[<%= product.textcolor %>]">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="font-semibold text-xl mb-1" title="<%= product.name %>">
                                        <%= product.name %>
                                    </h3>
                                    <p class="text-lg font-medium">₹ <%= product.price %></p>
                                </div>
                                <div class="flex gap-2">
                                    <a 
                                        href="/products/edit/<%= product._id %>" 
                                        class="w-10 h-10 flex items-center justify-center rounded-full bg-white shadow hover:bg-gray-100 transition-colors"
                                        title="Edit Product"
                                    >
                                        <i class="ri-edit-line text-gray-700"></i>
                                    </a>
                                    <a 
                                        href="/products/delete/<%= product._id %>" 
                                        class="w-10 h-10 flex items-center justify-center rounded-full bg-white shadow hover:bg-red-100 transition-colors"
                                        title="Delete Product"
                                    >
                                        <i class="ri-delete-bin-line text-red-500"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>
<%- include('./partials/footer') %>
