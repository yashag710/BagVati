<%- include('partials/header') %>
<% success.forEach(function (msg) { %><div hidden data-toast="<%= msg %>"></div><% }) %>
<% error.forEach(function (msg) { %><div hidden data-toast="<%= msg %>" data-toast-type="error"></div><% }) %>

<%
    const reviews = (product.reviews || []).slice().reverse(); // newest first
    const avg = reviews.length ? Math.round(reviews.reduce((sum, r) => sum + (r.review.rating || 0), 0) / reviews.length * 10) / 10 : 0;
    const breakdown = [5, 4, 3, 2, 1].map((stars) => ({ stars, count: reviews.filter((r) => Math.round(r.review.rating) === stars).length }));
    const discount = product.discount || 0;
    const finalPrice = product.price - discount;
    const discountPct = product.price ? Math.round(discount / product.price * 100) : 0;
    const imageSrc = (p) => p.image ? 'data:image/jpeg;base64,' + p.image.toString('base64') : '';
%>

<div class="w-full bg-gray-50">
  <div class="max-w-7xl mx-auto pt-32 pb-20 px-4 sm:px-6">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/shop" class="inline-flex items-center gap-1 hover:text-orange-500"><i class="ri-arrow-left-line" aria-hidden="true"></i> Shop</a>
      <span class="mx-2">/</span>
      <span class="text-gray-700"><%= product.name %></span>
    </nav>

    <!-- Product -->
    <section class="grid md:grid-cols-2 gap-8 lg:gap-14 items-start">
      <div class="rounded-2xl shadow-lg bg-[<%= product.bgcolor %>] aspect-square flex items-center justify-center p-8 md:sticky md:top-28">
        <% if (product.image) { %>
          <img src="<%= imageSrc(product) %>" alt="<%= product.name %>" class="max-h-full max-w-full object-contain">
        <% } %>
      </div>

      <div class="flex flex-col">
        <h1 class="header-title text-3xl md:text-5xl text-gray-900 leading-tight"><%= product.name %></h1>

        <a href="#reviews" class="mt-3 inline-flex items-center gap-2 text-sm text-gray-600 hover:text-orange-500 w-fit">
          <%- include('partials/stars', { rating: avg, size: 'text-lg' }) %>
          <% if (reviews.length) { %>
            <span class="font-semibold text-gray-800"><%= avg %></span>
            <span>(<%= reviews.length %> review<%= reviews.length !== 1 ? 's' : '' %>)</span>
          <% } else { %>
            <span>No reviews yet</span>
          <% } %>
        </a>

        <div class="mt-6 flex flex-wrap items-baseline gap-3">
          <span class="text-3xl md:text-4xl font-bold text-gray-900">₹ <%= finalPrice %></span>
          <% if (discount > 0) { %>
            <span class="text-lg line-through text-gray-400">₹ <%= product.price %></span>
            <span class="px-2 py-0.5 rounded-md bg-green-100 text-green-700 text-sm font-semibold"><%= discountPct %>% off</span>
          <% } %>
        </div>
        <% if (discount > 0) { %>
          <p class="mt-1 text-sm text-green-600">You save ₹ <%= discount %></p>
        <% } %>

        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <% if (user) { %>
            <%- include('partials/add-to-cart', { product, inCart, variant: 'full' }) %>
            <a href="/cart" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-lg font-semibold border border-orange-500 text-orange-500 hover:bg-orange-50">Go to cart</a>
          <% } else { %>
            <a href="/main" class="inline-flex items-center justify-center px-8 py-3.5 rounded-lg font-semibold text-white bg-orange-500 hover:bg-orange-600">Login to buy</a>
          <% } %>
        </div>

        <ul class="mt-10 grid sm:grid-cols-3 gap-4 text-sm">
          <li class="flex items-center gap-3 bg-white rounded-lg shadow-sm p-4">
            <i class="ri-shield-check-line text-2xl text-orange-500" aria-hidden="true"></i>
            <span class="text-gray-700">Secure checkout</span>
          </li>
          <li class="flex items-center gap-3 bg-white rounded-lg shadow-sm p-4">
            <i class="ri-truck-line text-2xl text-orange-500" aria-hidden="true"></i>
            <span class="text-gray-700">Delivered to your door</span>
          </li>
          <li class="flex items-center gap-3 bg-white rounded-lg shadow-sm p-4">
            <i class="ri-refresh-line text-2xl text-orange-500" aria-hidden="true"></i>
            <a href="/refund-policy" class="text-gray-700 hover:text-orange-500 underline-offset-2 hover:underline">Refund policy</a>
          </li>
        </ul>
      </div>
    </section>

    <!-- Reviews -->
    <section id="reviews" class="mt-20 scroll-mt-28">
      <h2 class="header-title text-2xl md:text-3xl text-gray-800 mb-8">Customer reviews</h2>

      <div class="grid lg:grid-cols-3 gap-8 items-start">
        <!-- Summary + form -->
        <div class="space-y-6">
          <div class="bg-white rounded-xl shadow p-6">
            <div class="flex items-center gap-4">
              <span class="text-5xl font-bold text-gray-900"><%= reviews.length ? avg : '-' %></span>
              <div>
                <%- include('partials/stars', { rating: avg, size: 'text-xl' }) %>
                <p class="text-sm text-gray-500 mt-1"><%= reviews.length %> review<%= reviews.length !== 1 ? 's' : '' %></p>
              </div>
            </div>
            <ul class="mt-6 space-y-2">
              <% breakdown.forEach(function (row) { %>
                <% const pct = reviews.length ? Math.round(row.count / reviews.length * 100) : 0; %>
                <li class="flex items-center gap-3 text-sm">
                  <span class="w-10 text-gray-600"><%= row.stars %> <i class="ri-star-fill text-yellow-400" aria-hidden="true"></i></span>
                  <span class="flex-1 h-2 rounded-full bg-gray-100 overflow-hidden" role="img" aria-label="<%= row.count %> reviews with <%= row.stars %> stars">
                    <span class="block h-full bg-yellow-400 rounded-full" style="width: <%= pct %>%"></span>
                  </span>
                  <span class="w-6 text-right text-gray-500"><%= row.count %></span>
                </li>
              <% }) %>
            </ul>
          </div>

          <div class="bg-white rounded-xl shadow p-6">
            <h3 class="font-semibold text-gray-800">Write a review</h3>
            <% if (user) { %>
              <form action="/products/<%= product._id %>/review" method="POST" class="mt-4 space-y-3">
                <div class="flex items-center gap-3">
                  <label for="rating" class="text-sm font-medium text-gray-700">Your rating</label>
                  <select id="rating" name="rating" class="border border-gray-300 rounded-md px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300">
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Good</option>
                    <option value="3">3 - Average</option>
                    <option value="2">2 - Poor</option>
                    <option value="1">1 - Terrible</option>
                  </select>
                </div>
                <label for="comment" class="sr-only">Your review</label>
                <textarea id="comment" name="comment" required rows="4" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" placeholder="What did you like or dislike?"></textarea>
                <button type="submit" class="w-full px-5 py-2.5 bg-orange-500 text-white rounded-md font-medium hover:bg-orange-600">Submit review</button>
              </form>
            <% } else { %>
              <a href="/main" class="mt-3 inline-block text-sm text-orange-500 hover:underline">Login to write a review</a>
            <% } %>
          </div>
        </div>

        <!-- List -->
        <div class="lg:col-span-2 space-y-4">
          <% if (reviews.length === 0) { %>
            <div class="bg-white rounded-xl shadow p-10 text-center text-gray-500">
              <i class="ri-chat-3-line text-4xl text-orange-500" aria-hidden="true"></i>
              <p class="mt-3">No reviews yet. Be the first to share your thoughts.</p>
            </div>
          <% } else { %>
            <% reviews.forEach(function (r) { %>
              <% const name = (r.review.user && r.review.user.fullname) || 'Anonymous'; %>
              <article class="bg-white rounded-xl shadow p-5">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="w-10 h-10 flex-shrink-0 rounded-full bg-orange-100 text-orange-600 font-semibold flex items-center justify-center" aria-hidden="true"><%= name.charAt(0).toUpperCase() %></span>
                    <div class="min-w-0">
                      <p class="font-medium text-gray-800 truncate"><%= name %></p>
                      <p class="text-xs text-gray-500"><%= new Date(r.review.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
                    </div>
                  </div>
                  <%- include('partials/stars', { rating: r.review.rating || 0, size: 'text-sm' }) %>
                </div>
                <p class="mt-3 text-gray-700 break-words"><%= r.review.comment %></p>
              </article>
            <% }) %>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Related -->
    <% if (related.length) { %>
      <section class="mt-20">
        <h2 class="header-title text-2xl md:text-3xl text-gray-800 mb-8">You may also like</h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          <% related.forEach(function (p) { %>
            <a href="/products/<%= p._id %>" class="group bg-white rounded-xl shadow hover:shadow-lg transition overflow-hidden flex flex-col">
              <div class="bg-[<%= p.bgcolor %>] h-40 sm:h-52 flex items-center justify-center p-4">
                <% if (p.image) { %>
                  <img src="<%= imageSrc(p) %>" alt="<%= p.name %>" class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105" loading="lazy">
                <% } %>
              </div>
              <div class="p-4">
                <p class="font-semibold text-gray-800 truncate group-hover:text-orange-500"><%= p.name %></p>
                <p class="mt-1 text-sm">
                  <span class="font-semibold text-gray-900">₹ <%= p.price - (p.discount || 0) %></span>
                  <% if (p.discount > 0) { %><span class="ml-1 line-through text-gray-400">₹ <%= p.price %></span><% } %>
                </p>
              </div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
