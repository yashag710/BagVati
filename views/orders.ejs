<%- include('partials/header') %>

<div class="max-w-7xl mx-auto pt-32 pb-20 px-6">
  <h1 class="header-title text-3xl md:text-4xl text-gray-800 mb-8">My Orders</h1>
  <% if (!orders || orders.length === 0) { %>
    <div class="bg-white rounded-xl shadow p-8 text-center text-gray-600">You have not placed any orders yet.</div>
  <% } else { %>
    <div class="overflow-x-auto py-4">
      <div class="flex gap-6 w-max items-stretch">
        <% orders.forEach(function(product){ %>
          <div class="bg-white rounded-lg shadow-md w-80 flex-shrink-0 flex flex-col border border-gray-100 hover:shadow-lg transition">
            <div class="h-44 bg-[<%= product.bgcolor %>] flex items-center justify-center p-4 border-b">
              <img src="<%= product.image ? `data:image/jpeg;base64,${product.image.toString('base64')}` : '/images/placeholder.png' %>" alt="<%= product.name %>" class="max-h-36 object-contain mx-auto" />
            </div>
            <div class="p-4 flex-1 flex flex-col justify-between">
              <h3 class="text-lg font-semibold truncate mb-2"><%= product.name %></h3>
              <div class="flex items-center gap-2 mb-2">
                <span class="text-sm line-through text-gray-400">₹ <%= product.price %></span>
                <span class="text-lg font-semibold text-green-600">₹ <%= product.price - (product.discount || 0) %></span>
              </div>
              <% if (product.discount > 0) { %>
                <span class="text-xs text-red-500 mb-2">You saved ₹ <%= product.discount %></span>
              <% } %>
              <div class="mt-auto flex items-center gap-2">
                <span class="inline-block px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold">Delivered</span>
                <span class="text-gray-400 text-xs">Order ID: <%= product._id %></span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
