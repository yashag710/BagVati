<%- include('partials/header') %>
<% const cartIds = new Set(((user && user.cart) || []).map(String)); %>

<div class="w-full min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto pt-32 pb-20 px-4 sm:px-6">
    <div class="flex items-end justify-between gap-4 mb-8">
      <h1 class="header-title text-3xl md:text-4xl text-gray-800">My Orders</h1>
      <% if (orders && orders.length) { %>
        <span class="text-sm text-gray-500"><%= orders.length %> item<%= orders.length !== 1 ? 's' : '' %></span>
      <% } %>
    </div>

    <% if (!orders || orders.length === 0) { %>
      <div class="bg-white rounded-xl shadow p-10 text-center">
        <i class="ri-shopping-bag-3-line text-4xl text-orange-500" aria-hidden="true"></i>
        <p class="mt-3 text-gray-600">You have not placed any orders yet.</p>
        <a href="/shop" class="inline-block mt-6 px-6 py-2.5 rounded-lg bg-orange-500 text-white font-semibold hover:bg-orange-600">Start shopping</a>
      </div>
    <% } else { %>
      <ul class="bg-white rounded-xl shadow divide-y divide-gray-100">
        <% orders.forEach(function (product) { %>
          <% const discount = product.discount || 0; %>
          <li class="p-4 sm:p-5 flex gap-4 sm:gap-6">
            <a href="/products/<%= product._id %>" class="flex-shrink-0 w-20 h-20 sm:w-28 sm:h-28 rounded-lg bg-[<%= product.bgcolor %>] flex items-center justify-center p-2" aria-label="View <%= product.name %>">
              <% if (product.image) { %>
                <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="" class="max-h-full max-w-full object-contain" />
              <% } %>
            </a>

            <div class="flex-1 min-w-0 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 sm:gap-6">
              <div class="min-w-0">
                <a href="/products/<%= product._id %>" class="block text-base sm:text-lg font-semibold text-gray-800 truncate hover:text-orange-500"><%= product.name %></a>
                <div class="mt-1 flex items-center gap-2">
                  <span class="text-base font-semibold text-gray-900">₹ <%= product.price - discount %></span>
                  <% if (discount > 0) { %>
                    <span class="text-sm line-through text-gray-400">₹ <%= product.price %></span>
                    <span class="text-xs font-medium text-green-600">You saved ₹ <%= discount %></span>
                  <% } %>
                </div>
                <span class="inline-flex items-center gap-1 mt-2 px-2.5 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-semibold">
                  <i class="ri-check-line" aria-hidden="true"></i> Delivered
                </span>
              </div>

              <div class="flex items-center gap-4 sm:flex-col sm:items-end sm:gap-2 flex-shrink-0">
                <%- include('partials/add-to-cart', { product, inCart: cartIds.has(String(product._id)), variant: 'again' }) %>
                <a href="/products/<%= product._id %>" class="text-sm text-gray-600 hover:text-orange-500">View product</a>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
