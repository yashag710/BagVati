<%- include('./partials/header') %>
<% if (success.length > 0) { %>
    <div class="absolute top-5 left-1/2 transform -translate-x-1/2 p-3 rounded-md bg-blue-500 shadow-md">
        <span class="text-white font-medium">
            <%= success %>
        </span>
    </div>
<% } %>

<div class="max-w-7xl mx-auto p-6 bg-gray-100">
    <!-- Header Section -->
    <div class="text-center mt-24">
        <h1 class="header-title text-4xl md:text-6xl font-bold">
            <span class="text-orange-500 italic">Shop</span> NOW
        </h1>
        <p class="text-gray-500 tracking-wide uppercase text-sm mt-2">Explore Our Collection</p>
        <p class="text-gray-700 text-base mt-4">Find the perfect product to suit your style and needs.</p>
    </div>

    <!-- Main Content -->
    <div class="flex flex-wrap mt-10">
        <!-- Sidebar -->
        <div class="w-full lg:w-1/4 pr-6 mb-10 lg:mb-0">
            <div class="bg-white p-6 rounded-lg shadow-md">
                <!-- Sort By -->
                <h3 class="text-lg font-semibold mb-4">Sort by</h3>
                <form action="/shop" method="GET">
                    <select id="sortSelect" class="w-full border px-3 py-2 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500" name="sortby" onchange="this.form.submit()">
                        <option value="popular">Popular</option>
                        <option value="newest">Newest</option>
                    </select>
                </form>
                <!-- Links -->
                <div class="mt-8">
                    <h3 class="text-lg font-semibold mb-4">Explore</h3>
                    <a href="" class="block text-gray-700 hover:text-orange-500 mb-2">New Collection</a>
                    <a href="" class="block text-gray-700 hover:text-orange-500 mb-2">All Products</a>
                    <a href="" class="block text-gray-700 hover:text-orange-500 mb-2">Discounted Products</a>
                </div>
                <!-- Filters -->
                <div class="mt-8">
                    <h3 class="text-lg font-semibold mb-4">Filter by</h3>
                    <a href="" class="block text-gray-700 hover:text-orange-500 mb-2">Availability</a>
                    <a href="" class="block text-gray-700 hover:text-orange-500 mb-2">Discount</a>
                </div>
            </div>
        </div>

        <!-- Products Section -->
        <div class="w-full lg:w-3/4">
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% products.forEach(function (product) { %>
                    <% const reviews = product.reviews || []; %>
                    <div class="bg-white rounded-xl shadow-lg overflow-hidden flex flex-col h-full relative">
                        <!-- Product Image -->
                        <div class="relative bg-[<%= product.bgcolor %>] flex items-center justify-center h-72">
                            <img class="max-h-60 w-auto object-contain" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>">
                            <div class="absolute top-4 left-4 bg-white/95 text-base text-gray-800 px-3 py-1.5 rounded-lg font-semibold">₹ <%= product.price %></div>
                        </div>

                        <!-- Reviews Overlay (hidden) -->
                        <div id="reviews-overlay-<%= product._id %>" class="absolute inset-0 z-40 hidden items-start justify-center p-6">
                            <div class="w-full max-w-2xl mx-auto bg-white rounded-lg shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-250">
                                <div class="p-4 border-b flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <h4 class="font-semibold">Reviews for <span class="text-orange-500"><%= product.name %></span></h4>
                                        <span class="text-sm text-gray-500">(<%= reviews.length %>)</span>
                                    </div>
                                    <div>
                                        <button type="button" class="close-overlay text-gray-600 hover:text-gray-800" data-productid="<%= product._id %>">Close ✕</button>
                                    </div>
                                </div>
                                <div class="p-4 max-h-64 overflow-y-auto space-y-3 bg-gray-50">
                                    <% if (reviews.length === 0) { %>
                                        <p class="text-sm text-gray-500">No reviews yet.</p>
                                    <% } else { %>
                                        <% reviews.forEach(function(r){ %>
                                            <div class="p-3 bg-white border rounded">
                                                <div class="flex items-start justify-between">
                                                    <div>
                                                        <div class="font-medium"><%= r.review.user && r.review.user.name ? r.review.user.name : 'Anonymous' %></div>
                                                        <div class="text-xs text-gray-500"><%= new Date(r.review.createdAt).toLocaleDateString() %></div>
                                                    </div>
                                                    <div class="text-sm text-yellow-500">Rating: <%= r.review.rating %>/5</div>
                                                </div>
                                                <p class="mt-2 text-sm text-gray-700"><%= r.review.comment %></p>
                                            </div>
                                        <% }) %>
                                    <% } %>
                                </div>
                                <% if (user) { %>
                                    <div class="p-4 border-t bg-white">
                                        <form id="overlay-review-form-<%= product._id %>" action="/products/<%= product._id %>/review" method="POST" class="space-y-3">
                                            <div class="flex gap-3 items-center">
                                                <label for="overlay-rating-<%= product._id %>" class="text-sm">Rating</label>
                                                <select id="overlay-rating-<%= product._id %>" name="rating" class="border rounded px-2 py-1">
                                                    <option value="5">5</option>
                                                    <option value="4">4</option>
                                                    <option value="3">3</option>
                                                    <option value="2">2</option>
                                                    <option value="1">1</option>
                                                </select>
                                            </div>
                                            <div>
                                                <textarea id="overlay-comment-<%= product._id %>" name="comment" required rows="4" class="w-full border rounded px-3 py-2" placeholder="Write your review..."></textarea>
                                            </div>
                                            <div class="text-right">
                                                <button type="submit" class="px-4 py-2 bg-orange-500 text-white rounded">Submit Review</button>
                                            </div>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Product Details -->
                        <div class="p-6 flex-1 flex flex-col justify-between bg-[<%= product.panelcolor %>] text-[<%= product.textcolor %>]">
                            <div class="flex items-start justify-between gap-4">
                                <div class="flex-1">
                                    <h3 class="text-xl font-semibold leading-tight mb-1"><%= product.name %></h3>
                                    <div class="text-sm text-gray-600">&nbsp;</div>
                                </div>
                                <div class="flex-shrink-0">
                                    <form action="/users/addtocart/<%= product._id %>" method="POST" class="inline">
                                        <button type="submit" class="px-4 py-2 bg-white rounded shadow text-gray-800 hover:bg-gray-100 text-base" title="Add to cart">
                                            <i class="ri-add-line"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <div class="mt-4 flex items-center justify-between">
                                <div class="flex items-center gap-3 text-base text-gray-700">
                                    <i class="ri-star-fill text-yellow-400"></i>
                                    <span class="font-medium"><%= reviews.length %> review<%= reviews.length !== 1 ? 's' : '' %></span>
                                </div>

                                <div class="flex items-center gap-3">
                                    <button type="button" class="toggle-reviews inline-flex items-center gap-2 px-4 py-2 border border-gray-200 rounded text-base text-gray-700 hover:bg-gray-50" data-productid="<%= product._id %>">
                                        <i class="ri-chat-3-line"></i>
                                        <span>Reviews</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="p-4 border-t bg-white flex items-center justify-between">
                            <% if (user) { %>
                                <button type="button" class="text-base text-orange-500 hover:underline open-overlay-btn" data-productid="<%= product._id %>">Write a review</button>
                            <% } else { %>
                                <a href="/main" class="text-base text-gray-500">Login to review</a>
                            <% } %>
                            <a href="/products/<%= product._id %>" class="text-base text-gray-600 hover:text-orange-500">View</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<script>
    function getQueryParam(param) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
    }

    // Set the selected value on page load
    document.addEventListener("DOMContentLoaded", function () {
        const sortValue = getQueryParam("sortby"); // Get "sortby" from URL
        if (sortValue) {
            document.getElementById("sortSelect").value = sortValue; // Set the selected option
        }
        // Attach review toggles
        // inline reviews overlay toggles (animated overlay over card)
        function openOverlay(id){
            const overlay = document.getElementById('reviews-overlay-' + id);
            if(!overlay) return;
            const inner = overlay.firstElementChild; // modal container
            overlay.classList.remove('hidden');
            // allow layout then animate
            requestAnimationFrame(() => {
                inner.classList.remove('scale-95','opacity-0');
                inner.classList.add('scale-100','opacity-100');
            });
        }

        function closeOverlay(id){
            const overlay = document.getElementById('reviews-overlay-' + id);
            if(!overlay) return;
            const inner = overlay.firstElementChild;
            inner.classList.remove('scale-100','opacity-100');
            inner.classList.add('scale-95','opacity-0');
            setTimeout(() => overlay.classList.add('hidden'), 220);
        }

        document.querySelectorAll('.toggle-reviews').forEach(function(btn){
            btn.addEventListener('click', function(){
                const id = this.dataset.productid;
                openOverlay(id);
            });
        });

        // buttons that open the overlay directly (Write a review)
        document.querySelectorAll('.open-overlay-btn').forEach(function(btn){
            btn.addEventListener('click', function(){
                const id = this.dataset.productid;
                openOverlay(id);
                // focus textarea when overlay opens
                setTimeout(() => {
                    const ta = document.getElementById('overlay-comment-' + id);
                    if(ta) ta.focus();
                }, 250);
            });
        });

        // close overlay buttons
        document.querySelectorAll('.close-overlay').forEach(function(btn){
            btn.addEventListener('click', function(){
                const id = this.dataset.productid;
                closeOverlay(id);
            });
        });

        // close overlay when clicking outside inner modal
        document.querySelectorAll('[id^="reviews-overlay-"]').forEach(function(overlay){
            overlay.addEventListener('click', function(e){
                if(e.target === overlay){
                    const id = overlay.id.replace('reviews-overlay-','');
                    closeOverlay(id);
                }
            });
        });
    });
</script>

<%- include('./partials/footer') %>
