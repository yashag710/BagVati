<%- include('./partials/header') %>
<% success.forEach(function (msg) { %><div hidden data-toast="<%= msg %>"></div><% }) %>
<% const cartIds = new Set(((user && user.cart) || []).map(String)); %>
<% const reviewerName = (r) => (r.review.user && r.review.user.fullname) || 'Anonymous'; %>
<% const avgRating = (reviews) => reviews.length ? Math.round(reviews.reduce((sum, r) => sum + (r.review.rating || 0), 0) / reviews.length * 10) / 10 : 0; %>

<div class="max-w-7xl mx-auto p-6 bg-gray-100">
    <!-- Header Section -->
    <div class="text-center mt-24">
        <h1 class="header-title text-4xl md:text-6xl font-bold">
            <span class="text-orange-500 italic">Shop</span> NOW
        </h1>
        <p class="text-gray-500 tracking-wide uppercase text-sm mt-2">Explore Our Collection</p>
        <p class="text-gray-700 text-base mt-4">Find the perfect product to suit your style and needs.</p>
    </div>

    <!-- Main Content -->
    <div class="flex flex-wrap mt-10">
        <!-- Sidebar -->
        <div class="w-full lg:w-1/4 pr-6 mb-10 lg:mb-0">
            <div class="bg-white p-6 rounded-lg shadow-md">
                <!-- Sort By -->
                <h3 class="text-lg font-semibold mb-4">Sort by</h3>
                <form action="/shop" method="GET">
                    <select id="sortSelect" class="w-full border px-3 py-2 rounded-md focus:outline-none focus:ring-2 focus:ring-orange-500" name="sortby" onchange="this.form.submit()">
                        <option value="popular">Popular</option>
                        <option value="newest">Newest</option>
                    </select>
                </form>
                <!-- Links -->
                <div class="mt-8">
                    <h3 class="text-lg font-semibold mb-4">Explore</h3>
                    <a href="" class="block text-gray-700 hover:text-orange-500 mb-2">New Collection</a>
                    <a href="" class="block text-gray-700 hover:text-orange-500 mb-2">All Products</a>
                    <a href="" class="block text-gray-700 hover:text-orange-500 mb-2">Discounted Products</a>
                </div>
                <!-- Filters -->
                <div class="mt-8">
                    <h3 class="text-lg font-semibold mb-4">Filter by</h3>
                    <a href="" class="block text-gray-700 hover:text-orange-500 mb-2">Availability</a>
                    <a href="" class="block text-gray-700 hover:text-orange-500 mb-2">Discount</a>
                </div>
            </div>
        </div>

        <!-- Products Section -->
        <div class="w-full lg:w-3/4">
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% products.forEach(function (product) { %>
                    <% const reviews = product.reviews || []; %>
                    <% const avg = avgRating(reviews); %>
                    <div class="bg-white rounded-xl shadow-lg overflow-hidden flex flex-col h-full">
                        <!-- Product Image -->
                        <a href="/products/<%= product._id %>" class="relative bg-[<%= product.bgcolor %>] flex items-center justify-center h-72 group/img" aria-label="View <%= product.name %>">
                            <% if (product.image) { %>
                                <img class="max-h-60 w-auto object-contain transition-transform duration-300 group-hover/img:scale-105" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>">
                            <% } %>
                            <div class="absolute top-4 left-4 bg-white/95 text-base text-gray-800 px-3 py-1.5 rounded-lg font-semibold">₹ <%= product.price %></div>
                        </a>

                        <!-- Product Details -->
                        <div class="p-6 flex-1 flex flex-col justify-between bg-[<%= product.panelcolor %>] text-[<%= product.textcolor %>]">
                            <div class="flex items-start justify-between gap-4">
                                <h3 class="flex-1 min-w-0 text-xl font-semibold leading-tight">
                                    <a href="/products/<%= product._id %>" class="hover:text-orange-500"><%= product.name %></a>
                                </h3>
                                <div class="flex-shrink-0">
                                    <%- include('./partials/add-to-cart', { product, inCart: cartIds.has(String(product._id)), variant: 'icon' }) %>
                                </div>
                            </div>

                            <div class="mt-6 flex items-center justify-between gap-3">
                                <div class="flex items-center gap-1.5 text-sm text-gray-700 whitespace-nowrap">
                                    <% if (reviews.length) { %>
                                        <i class="ri-star-fill text-yellow-400 text-base" aria-hidden="true"></i>
                                        <span class="font-semibold"><%= avg %></span>
                                        <span class="text-gray-500">(<%= reviews.length %> review<%= reviews.length !== 1 ? 's' : '' %>)</span>
                                    <% } else { %>
                                        <span class="text-gray-500">No reviews yet</span>
                                    <% } %>
                                </div>
                                <button type="button" data-open-reviews="<%= product._id %>" class="inline-flex items-center gap-2 px-4 py-2 border border-gray-200 rounded text-sm text-gray-700 hover:bg-gray-50">
                                    <i class="ri-chat-3-line" aria-hidden="true"></i>
                                    <span>Reviews</span>
                                </button>
                            </div>
                        </div>

                        <div class="p-4 border-t bg-white flex items-center justify-between">
                            <% if (user) { %>
                                <button type="button" data-open-reviews="<%= product._id %>" data-focus-comment class="text-base text-orange-500 hover:underline">Write a review</button>
                            <% } else { %>
                                <a href="/main" class="text-base text-gray-500">Login to review</a>
                            <% } %>
                            <a href="/products/<%= product._id %>" class="inline-flex items-center gap-1 text-base text-gray-600 hover:text-orange-500">View <i class="ri-arrow-right-line" aria-hidden="true"></i></a>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<!-- Reviews modals: rendered outside the cards so the card's overflow/size can't clip them -->
<% products.forEach(function (product) { %>
    <% const reviews = (product.reviews || []).slice().reverse(); %>
    <% const avg = avgRating(reviews); %>
    <div id="reviews-modal-<%= product._id %>" class="reviews-modal fixed inset-0 z-[60] hidden items-center justify-center bg-black/50 p-4" role="dialog" aria-modal="true" aria-labelledby="reviews-title-<%= product._id %>">
        <div class="modal-panel w-full max-w-lg max-h-[90vh] flex flex-col bg-white rounded-xl shadow-2xl overflow-hidden transition duration-200 scale-95 opacity-0">
            <div class="px-5 py-4 border-b flex items-start justify-between gap-4">
                <div class="min-w-0">
                    <p class="text-xs uppercase tracking-wide text-gray-500">Reviews</p>
                    <h2 id="reviews-title-<%= product._id %>" class="header-title text-xl md:text-2xl text-gray-800 truncate"><%= product.name %></h2>
                    <div class="mt-1 flex items-center gap-2 text-sm text-gray-600">
                        <%- include('./partials/stars', { rating: avg }) %>
                        <span><%= reviews.length ? avg + ' · ' : '' %><%= reviews.length %> review<%= reviews.length !== 1 ? 's' : '' %></span>
                    </div>
                </div>
                <button type="button" data-close-reviews class="w-9 h-9 flex-shrink-0 inline-flex items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 hover:text-gray-800" aria-label="Close reviews">
                    <i class="ri-close-line text-xl" aria-hidden="true"></i>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto px-5 py-4 space-y-3 bg-gray-50">
                <% if (reviews.length === 0) { %>
                    <p class="text-sm text-gray-500 text-center py-6">No reviews yet. Be the first to share your thoughts.</p>
                <% } else { %>
                    <% reviews.forEach(function (r) { %>
                        <div class="p-4 bg-white border border-gray-100 rounded-lg">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="font-medium text-gray-800 truncate"><%= reviewerName(r) %></div>
                                    <div class="text-xs text-gray-500"><%= new Date(r.review.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></div>
                                </div>
                                <%- include('./partials/stars', { rating: r.review.rating || 0, size: 'text-sm' }) %>
                            </div>
                            <p class="mt-2 text-sm text-gray-700 break-words"><%= r.review.comment %></p>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <div class="px-5 py-4 border-t bg-white">
                <% if (user) { %>
                    <form action="/products/<%= product._id %>/review" method="POST" class="space-y-3">
                        <div class="flex items-center gap-3">
                            <label for="rating-<%= product._id %>" class="text-sm font-medium text-gray-700">Your rating</label>
                            <select id="rating-<%= product._id %>" name="rating" class="border border-gray-300 rounded-md px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300">
                                <option value="5">5 - Excellent</option>
                                <option value="4">4 - Good</option>
                                <option value="3">3 - Average</option>
                                <option value="2">2 - Poor</option>
                                <option value="1">1 - Terrible</option>
                            </select>
                        </div>
                        <label for="comment-<%= product._id %>" class="sr-only">Your review</label>
                        <textarea id="comment-<%= product._id %>" name="comment" required rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-300" placeholder="What did you like or dislike?"></textarea>
                        <div class="flex justify-end">
                            <button type="submit" class="px-5 py-2 bg-orange-500 text-white rounded-md font-medium hover:bg-orange-600">Submit review</button>
                        </div>
                    </form>
                <% } else { %>
                    <a href="/main" class="text-sm text-orange-500 hover:underline">Login to write a review</a>
                <% } %>
            </div>
        </div>
    </div>
<% }) %>

<script>
    function getQueryParam(param) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
    }

    // Set the selected value on page load
    document.addEventListener("DOMContentLoaded", function () {
        const sortValue = getQueryParam("sortby"); // Get "sortby" from URL
        if (sortValue) {
            document.getElementById("sortSelect").value = sortValue; // Set the selected option
        }

        // Reviews modal
        let openModal = null;
        let lastTrigger = null;

        function openReviews(id, trigger, focusComment) {
            const modal = document.getElementById('reviews-modal-' + id);
            if (!modal) return;
            openModal = modal;
            lastTrigger = trigger;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            requestAnimationFrame(function () {
                modal.querySelector('.modal-panel').classList.remove('scale-95', 'opacity-0');
            });
            const target = (focusComment && modal.querySelector('textarea')) || modal.querySelector('[data-close-reviews]');
            target.focus();
        }

        function closeReviews() {
            if (!openModal) return;
            const modal = openModal;
            openModal = null;
            modal.querySelector('.modal-panel').classList.add('scale-95', 'opacity-0');
            setTimeout(function () {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }, 200);
            document.body.style.overflow = '';
            if (lastTrigger) lastTrigger.focus();
        }

        document.querySelectorAll('[data-open-reviews]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                openReviews(btn.dataset.openReviews, btn, btn.hasAttribute('data-focus-comment'));
            });
        });
        document.querySelectorAll('.reviews-modal').forEach(function (modal) {
            modal.addEventListener('click', function (e) {
                // backdrop click or close button
                if (e.target === modal || e.target.closest('[data-close-reviews]')) closeReviews();
            });
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeReviews();
        });
    });
</script>

<%- include('./partials/footer') %>
