<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-gray-50 pt-32 pb-20">
    <div class="container mx-auto px-6">
        <h1 class="header-title text-3xl md:text-4xl text-gray-800 mb-8">Your Cart</h1>
        
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Left Section: Product Details -->
            <div class="w-full lg:w-2/5">
                <div class="bg-white rounded-xl shadow-lg overflow-hidden">
                    <!-- Product Image -->
                    <div class="w-full h-80 bg-[<%= product.bgcolor %>] flex items-center justify-center">
                        <img 
                            src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" 
                            alt="<%= product.name %>"
                            class="h-72 w-full object-contain"
                        />
                    </div>
                    
                    <!-- Product Info -->
                    <div class="p-6 bg-[<%= product.panelcolor %>] text-[<%= product.textcolor %>]">
                        <h3 class="text-2xl font-semibold mb-2"><%= product.name %></h3>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-lg line-through text-gray-400">₹ <%= product.price %></span>
                                <span class="text-xl font-semibold text-green-600">₹ <%= product.price - product.discount %></span>
                            </div>
                            <span class="text-red-500 font-medium">Save ₹ <%= product.discount %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Section: Price Breakdown -->
            <div class="w-full lg:w-3/5">
                <div class="bg-white rounded-xl shadow-lg p-8">
                    <h3 class="text-2xl font-semibold text-gray-800 mb-6">Price Breakdown</h3>
                    
                    <div class="space-y-4">
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600">Total MRP</span>
                            <span class="text-gray-800">₹ <%= product.price %></span>
                        </div>
                        
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600">Discount on MRP</span>
                            <span class="text-red-500">-₹ <%= product.discount %></span>
                        </div>
                        
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600">Platform Fee</span>
                            <span class="text-gray-800">₹ 20</span>
                        </div>
                        
                        <div class="flex justify-between items-center">
                            <span class="text-gray-600">Shipping Fee</span>
                            <span class="text-green-500 font-medium">FREE</span>
                        </div>
                        
                        <div class="border-t border-gray-200 my-6"></div>
                        
                        <div class="flex justify-between items-center">
                            <span class="text-xl font-semibold text-gray-800">Total Amount</span>
                            <span class="text-2xl font-bold text-green-600">₹ <%= (product.price - product.discount) + 20 %></span>
                        </div>
                    </div>

                    <!-- Checkout Button -->
                    <form action="/checkout" method="POST" class="mt-8">
                        <input type="hidden" name="productId" value="<%= product._id %>">
                        <button type="submit" class="w-full bg-orange-500 text-white py-4 rounded-lg font-semibold hover:bg-orange-600 transition duration-300 flex items-center justify-center gap-2">
                            <i class="ri-shopping-bag-line"></i>
                            Proceed to Checkout
                        </button>
                    </form>

                    <!-- Secure Payment Info -->
                    <div class="mt-6 flex items-center justify-center gap-2 text-gray-500 text-sm">
                        <i class="ri-shield-check-line"></i>
                        <span>Secure Payment</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
