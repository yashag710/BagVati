<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-gray-50 pt-32 pb-20">
    <div class="container mx-auto px-6">
        <h1 class="header-title text-3xl md:text-4xl text-gray-800 mb-8">Your Cart</h1>

        <% if (!user || !user.cart || user.cart.length === 0) { %>
            <div class="bg-white rounded-xl shadow p-8 text-center text-gray-600">Your cart is empty.</div>
        <% } else { %>
            <!-- Horizontal scroll container -->
            <div class="overflow-x-auto py-4">
                <div class="flex gap-6 w-max items-stretch">
                    <% user.cart.forEach(function(product){ %>
                        <div class="bg-white rounded-lg shadow-md w-80 flex-shrink-0">
                            <div class="h-44 bg-[<%= product.bgcolor %>] flex items-center justify-center p-4">
                                <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>" class="max-h-36 object-contain" />
                            </div>
                            <div class="p-4">
                                <h3 class="text-lg font-semibold truncate"><%= product.name %></h3>
                                <div class="mt-2 flex items-center justify-between">
                                    <div>
                                        <div class="text-sm text-gray-500 line-through">₹ <%= product.price %></div>
                                        <div class="text-lg font-semibold text-green-600">₹ <%= product.price - (product.discount || 0) %></div>
                                    </div>
                                    <form action="/users/cart/remove/<%= product._id %>" method="POST">
                                        <button type="submit" class="text-sm text-red-500">Remove</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Checkout CTA -->
            <div class="mt-8 flex justify-end">
                <form action="/checkout" method="GET" class="w-full max-w-md">
                    <!-- For simplicity, checkout will process all items on the backend based on user.cart -->
                    <button type="submit" class="w-full bg-orange-500 text-white py-4 rounded-lg font-semibold hover:bg-orange-600 transition duration-300 flex items-center justify-center gap-2">
                        <i class="ri-shopping-bag-line"></i>
                        Checkout All Items
                    </button>
                </form>
            </div>
        <% } %>
    </div>
</div>

<%- include('./partials/footer') %>
