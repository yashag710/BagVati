<%- include('./partials/header') %>
    <div class="w-full h-screen flex px-20">
        <div class="w-1/2 flex items-center justify-center h-screen">
            <div class="w-full px-32">
                <h4 class="text-2xl capitalize mb-5">Admin Access</h4>
                <form action="/owners/login" method="post" id="loginForm">
                    <div id="loginMessage" class="hidden mb-4 p-3 rounded"></div>
                    <input class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                        type="email" placeholder="Email" name="email" id="email" required>
                    <input class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                        type="password" placeholder="Password" name="password" id="password" required>
                    <button type="submit" class="px-5 rounded-full py-3 mt-2 bg-blue-500 text-white w-full">Login</button>
                </form>
            </div>
        </div>
    </div>
    <%- include('./partials/footer') %>

<script>
document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(e.target);
    const loginMessage = document.getElementById('loginMessage');
    
    try {
        const response = await fetch('/owners/login', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                email: formData.get('email'),
                password: formData.get('password')
            })
        });
        
        if (response.redirected) {
            window.location.href = response.url;
            return;
        }
        
        const data = await response.json();
        
        loginMessage.classList.remove('hidden');
        loginMessage.classList.remove('bg-red-100', 'text-red-700', 'bg-green-100', 'text-green-700');
        
        if (data.success) {
            loginMessage.classList.add('bg-green-100', 'text-green-700');
            loginMessage.textContent = data.message;
            setTimeout(() => {
                window.location.href = '/owners/admin';
            }, 1000);
        } else {
            loginMessage.classList.add('bg-red-100', 'text-red-700');
            loginMessage.textContent = data.message;
        }
    } catch (error) {
        loginMessage.classList.remove('hidden');
        loginMessage.classList.add('bg-red-100', 'text-red-700');
        loginMessage.textContent = 'An error occurred. Please try again later.';
    }
});
</script>