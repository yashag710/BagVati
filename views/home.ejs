<%- include('partials/header') %>

<!-- Hero -->
<section class="pt-28 pb-12 bg-gradient-to-b from-orange-50 to-white">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center gap-8">
      <div class="md:w-1/2">
        <h2 class="header-title text-5xl md:text-6xl text-gray-800 font-bold leading-tight">Discover Timeless Bags</h2>
        <p class="mt-4 text-gray-600 max-w-xl">Shop curated styles and pre-loved luxury crafted for everyday elegance. Sustainable, stylish and built to last.</p>

        <div class="mt-6 flex items-center gap-4">
          <a href="/shop" class="inline-block bg-orange-500 text-white px-6 py-3 rounded-full font-semibold hover:opacity-95 transition">Shop Now</a>
          <% if(!user || !owner) { %>
          <a href="/main" class="inline-block bg-white text-orange-500 px-5 py-3 rounded-full border border-orange-200 font-medium hover:bg-orange-50 transition">Sign Up / Login</a>
          <% } %>
        </div>
      </div>

      <div class="md:w-1/2 grid grid-cols-2 gap-4">
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
          <img src="/images/red_bag.png" alt="Red Bag" class="w-full h-72 object-cover">
        </div>
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
          <img src="/images/gold_bag.png" alt="Gold Bag" class="w-full h-72 object-cover">
        </div>
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
          <img src="/images/green_bag.png" alt="Green Bag" class="w-full h-72 object-cover">
        </div>
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
          <img src="/images/black_bag.png" alt="Black Bag" class="w-full h-72 object-cover">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section class="py-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-lg shadow-sm text-center">
        <i class="ri-24-hours-line text-3xl text-orange-500 mb-3"></i>
        <h3 class="font-semibold text-lg">Quality Craftsmanship</h3>
        <p class="text-gray-600 mt-2">Hand-checked products that meet our high quality standards.</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm text-center">
        <i class="ri-leaf-line text-3xl text-orange-500 mb-3"></i>
        <h3 class="font-semibold text-lg">Sustainable Materials</h3>
        <p class="text-gray-600 mt-2">We prioritize eco-friendly supplies and responsible production.</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-sm text-center">
        <i class="ri-truck-line text-3xl text-orange-500 mb-3"></i>
        <h3 class="font-semibold text-lg">Fast Shipping</h3>
        <p class="text-gray-600 mt-2">Reliable delivery handled through trusted carriers.</p>
      </div>
    </div>
  </div>
</section>

<!-- Newsletter -->
<section class="py-12 bg-orange-50">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h3 class="header-title text-2xl mb-3">Join Our Newsletter</h3>
    <p class="text-gray-600 mb-6">Get early access to new arrivals, exclusive deals and style tips.</p>
    <form action="/subscribe" method="POST" class="flex flex-col sm:flex-row gap-3 justify-center">
      <input type="email" name="email" placeholder="Enter your email" required class="px-4 py-3 rounded-lg border border-gray-200 w-full sm:w-auto sm:flex-1">
      <button class="bg-orange-500 text-white px-6 py-3 rounded-lg font-semibold">Subscribe</button>
    </form>
  </div>
</section>

<!-- Footer -->
<%- include('partials/footer') %>

