<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bag Vati - New Arrival</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Roboto', sans-serif;
    }
    .header-title {
      font-family: 'Playfair Display', serif;
    }
  </style>
</head>
<body class="bg-gray-100">
  <!-- Container -->
  <div class="max-w-7xl mx-auto p-6">
    <!-- Header Section -->
    <div class="text-center">
      <h1 class="header-title text-4xl md:text-6xl font-bold">
        <span class="text-orange-500 italic">bag</span> VATI
      </h1>
      <p class="text-gray-500 tracking-wide uppercase text-sm mt-2">New Arrival</p>
      <p class="text-gray-700 text-base mt-4">Fueling fashion with resplendent Pre-loved Luxury.</p>
    </div>

    <!-- Products Section -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-10">
      <!-- Product 1 -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <img src="/images/red_bag.png" alt="Red Bag" class="w-full h-64 object-cover">
      </div>
      <!-- Product 2 -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <img src="/images/gold_bag.png" alt="Gold Bag" class="w-full h-64 object-cover">
      </div>
      <!-- Product 3 -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <img src="/images/green_bag.png" alt="Dark Red Bag" class="w-full h-64 object-cover">
      </div>
      <!-- Product 4 -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <img src="/images/black_bag.png" alt="Black Bag" class="w-full h-64 object-cover">
      </div>
    </div>
    <div class="mt-7">
      <a class="hover:text-blue-500" href="/main"> SignUp/Login </a>
    </div>
  </div>
</body>
</html>
