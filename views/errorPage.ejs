<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied</title>
    <script>
        setTimeout(() => {
            window.location.href = "<%= redirect %>";
        }, 2000); // Redirect after 3 seconds
    </script>
</head>
<body>
    <h1>Access Denied</h1>
    <p><%= message %></p>
    <p>Redirecting to login page in 2 seconds...</p>
</body>
</html>
