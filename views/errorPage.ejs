<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script>
        setTimeout(() => {
            window.location.href = "<%= redirect %>";
        }, 3000); // Redirect after 3 seconds
    </script>
</head>
<body>
    <h1><%= title %></h1>
    <p><%= message %></p>
    <p>Redirecting to the <a href="<%= redirect %>">home page</a> in 3 seconds...</p>
</body>
</html>
