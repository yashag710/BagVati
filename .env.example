# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Required ---

# MongoDB connection string. Must end with "/" — the app appends the database name "BagVati".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Secrets for signing login tokens and sessions. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
jwt_key=change-me
SESSION_SECRET=change-me

# Google login (Google Cloud Console > APIs & Services > Credentials > OAuth client ID).
# The server will not start without these; use any placeholder (e.g. x) if you don't need Google login locally.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Gmail account + app password used by the contact form (Google Account > Security > App passwords).
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-char-app-password

# --- Optional ---

# Defaults to /users/auth/google/callback on the current host. Set the full URL in production,
# and register the same URL in the Google OAuth client.
# GOOGLE_CALLBACK_URL=https://your-app.onrender.com/users/auth/google/callback

# PORT=3000
# NODE_ENV=production   # makes cookies secure (HTTPS only); leave unset locally
# RENDER=true           # enables the keep-alive ping on Render
